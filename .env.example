# Instagram --------------------------------------------------------------
# Token with instagram_business_manage_messages (Instagram Login) or
# instagram_manage_messages (Facebook Login for Business). Posting scopes are not
# enough — you will need to add the messaging scope and re-authorise, and turn on
# Settings > Messages > Connected tools > Allow access to messages in the app.
IG_ACCESS_TOKEN=
# App secret, used to verify the X-Hub-Signature-256 on every webhook delivery.
IG_APP_SECRET=
# Any string you choose; paste the same one into the Meta webhook setup form.
IG_VERIFY_TOKEN=

# Instagram Login (default) sends from the "me" node on graph.instagram.com.
# For Facebook Login for Business, set:
#   IG_BASE_URL=https://graph.facebook.com
#   IG_SEND_NODE=<your IG user id>
IG_BASE_URL=https://graph.instagram.com
IG_SEND_NODE=me
IG_API_VERSION=v23.0

# Optional. Only these two let the app read a sender's bio, via business_discovery,
# and only for professional accounts. Without them a lead is built from the messaging
# profile alone and bio stays unknown.
IG_USER_ID=
IG_DISCOVERY_TOKEN=

# Leave off until the human_agent permission is approved for your app. With it on,
# replies past the 24h window are sent with the HUMAN_AGENT tag (7 day limit).
IG_USE_HUMAN_AGENT_TAG=

# Telegram ---------------------------------------------------------------
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Your own chat id. Approvals from any other chat are ignored.
TELEGRAM_CHAT_ID=
# Any random string; Telegram echoes it back on every webhook delivery.
TELEGRAM_WEBHOOK_SECRET=

# Model ------------------------------------------------------------------
# "anthropic" or "gemini". Only the selected provider's key is needed.
LLM_PROVIDER=gemini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

GEMINI_API_KEY=
# Set the exact model id you want. A wrong id fails at draft time with a 404,
# not at startup, so check it against Google's model list before going live.
GEMINI_MODEL=gemini-2.5-flash

# Storage ----------------------------------------------------------------
DB_PATH=podcast_cover_dms.sqlite3
